{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npm ci && npm --prefix website ci",
  "buildCommand": "cd website && npm run build",
  "outputDirectory": "website/dist",
  "functions": { "api/account-jobs.js": { "maxDuration": 180 } },
  "rewrites": [
    { "source": "/share", "destination": "/share.html" },
    { "source": "/share/", "destination": "/share.html" },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/((?!assets/|api/|share(?:\\.html|/|$)|support(?:\\.html|/|$)|aria-roles(?:/|$)).*)",
      "destination": "/"
    }
  ],
  "headers": [
    {
      "source": "/people/:path*",
      "headers": [
        { "key": "Cache-Control", "value": "no-store" },
        { "key": "Referrer-Policy", "value": "no-referrer" },
        { "key": "X-Robots-Tag", "value": "noindex" }
      ]
    },
    {
      "source": "/confirm-interest",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/withdraw-interest",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/delete-interest",
      "headers": [
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    },
    {
      "source": "/account/:path*",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "no-store"
        },
        {
          "key": "Referrer-Policy",
          "value": "no-referrer"
        },
        {
          "key": "X-Robots-Tag",
          "value": "noindex"
        }
      ]
    }
  ]
}
