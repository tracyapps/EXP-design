# Reference only. Set private values in Vercel's exp-design project settings.
# For a private local copy use .env.accounts.local (gitignored).
# No VITE_ prefix: these values belong to server functions, never the browser.
# Use the exact preview origin first; use https://expdesign.app for production later.
ACCOUNT_PUBLIC_ORIGIN=
EXP_ACCOUNT_DATABASE_URL=
BETTER_AUTH_SECRET=
RESEND_API_KEY=
SIGNUP_FROM_EMAIL=

# Separate Pro-interest database; same site origin as ACCOUNT_PUBLIC_ORIGIN.
INTEREST_PUBLIC_ORIGIN=
EXP_INTEREST_DATABASE_URL=

# Stay off until schema, private hosted tests, delivery and privacy gates pass.
ACCOUNTS_ENABLED=false
ACCOUNT_BETA_ENABLED=false
ACCOUNT_PRO_LINK_ENABLED=false
ACCOUNT_COMMUNITY_ENABLED=false
ACCOUNT_NEWS_ENABLED=false
ACCOUNT_TICKETS_ENABLED=false
ACCOUNT_TICKET_MAIL_ENABLED=false
# Private scheduler only; use a separate restricted job role, never the owner.
EXP_ACCOUNT_JOBS_DATABASE_URL=
ACCOUNT_RETENTION_ENABLED=false
PRO_INTEREST_ENABLED=false
