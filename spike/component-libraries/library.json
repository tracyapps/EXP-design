    },
    {
      "id": "vue",
      "title": "Vue",
      "summary": "Vue 3.5 single-file components with <script setup lang=\"ts\">, built with Vite.",
      "mode": "mount",
      "build": "npm run build",
      "entry": "dist/preview.js",
      "expImport": "Today: tokens only. Components need FEAT-087 or SFC prop types.",
      "styles": [
        "styles/tokens.css",
        "styles/button.css",
        "styles/card.css",
        "styles/accordion.css"
      ],
      "files": {
        "button": [
          "src/ExpButton.vue",
