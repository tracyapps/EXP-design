    {
      "id": "react",
      "title": "React",
      "summary": "React 19 function components in TSX with CSF3 stories. esbuild library build + a preview bundle.",
      "mode": "mount",
      "build": "npm run build",
      "entry": "dist/preview.js",
      "expImport": "Today: tokens only. Components need FEAT-087 (Storybook argTypes) or TypeScript prop types.",
      "styles": [
        "styles/tokens.css",
        "styles/button.css",
        "styles/card.css",
        "styles/accordion.css"
      ],
      "files": {
        "button": [
          "src/Button.tsx",
